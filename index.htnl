<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Lily & Pearl | Aesthetic Jewellery</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            /* Palette */
            --golden-rose: #c88d94; 
            --baby-pink: #fce7f3;
            --sky-blue: #7dd3fc;
            --text-dark: #2d1820;
            --text-muted: #5a3c46;
            
            /* Typography */
            --font-calligraphy: 'Alex Brush', cursive;
            --font-sans: 'Poppins', sans-serif;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            font-family: var(--font-sans);
            color: var(--text-dark);
            overflow-x: hidden;
            font-size: 13px; /* Medium to Small as requested */
            line-height: 1.5;
            background-color: #000; /* Behind backgrounds */
        }

        /* --- BACKGROUNDS (Image files provided by you) --- */
        #fixed-bg-2 {
            position: fixed;
            top: 0; left: 0; width: 100vw; height: 100vh;
            background-image: url('1000004739.jpg');
            background-size: cover;
            background-position: center;
            z-index: -2;
            opacity: 0.70; /* 70% Visibility */
        }

        #hero-bg-1 {
            position: fixed;
            top: 0; left: 0; width: 100vw; height: 100vh;
            background-image: url('1000004738.jpg');
            background-size: cover;
            background-position: center;
            z-index: -1;
            transition: transform 0.6s ease-in-out, opacity 0.5s ease-in-out;
            will-change: transform, opacity;
        }

        /* Class added via JS when scrolled 30% */
        .hide-hero-bg {
            transform: translateY(-100%);
            opacity: 0;
        }

        /* --- 1. SPLASH SCREEN ANIMATION --- */
        #splash-screen {
            position: fixed;
            top: 0; left: 0; width: 100vw; height: 100vh;
            background: linear-gradient(135deg, var(--baby-pink), var(--sky-blue));
            z-index: 9999;
            display: flex;
            justify-content: center;
            align-items: center;
            animation: fadeOutSplash 0.6s ease 2.5s forwards;
        }

        .splash-content {
            display: flex;
            flex-direction: row; /* Logo and text in one line */
            align-items: center;
            gap: 12px;
            animation: popIn 1s ease forwards;
        }

        .splash-logo {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            border: 2px solid var(--golden-rose);
            object-fit: cover;
        }

        .splash-text {
            font-family: var(--font-calligraphy);
            font-size: 28px;
            color: #5c1d24;
            white-space: nowrap;
        }

        @keyframes popIn {
            0% { transform: scale(0.8); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }
        @keyframes fadeOutSplash {
            to { opacity: 0; visibility: hidden; }
        }

        /* --- 2. TOP NAVBAR --- */
        .navbar {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 55px;
            z-index: 1000;
            background: rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(8px);
            border-bottom: 1px solid rgba(200, 141, 148, 0.3);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 15px;
        }

        .nav-brand {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .nav-brand img {
            width: 35px; height: 35px;
            border-radius: 50%;
            border: 1px solid var(--golden-rose);
            object-fit: cover;
        }

        .nav-title {
            font-family: var(--font-calligraphy);
            font-size: 24px;
            color: var(--text-dark);
            text-shadow: 0px 0px 3px rgba(255,255,255,0.8);
        }

        .cart-icon-wrapper {
            position: relative;
            background: rgba(255,255,255,0.4);
            width: 36px; height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center; justify-content: center;
            color: var(--text-dark);
            font-size: 14px;
            cursor: pointer;
            border: 1px solid var(--sky-blue);
        }

        .cart-badge {
            position: absolute; top: -3px; right: -3px;
            background: var(--golden-rose); color: white;
            font-size: 9px; font-weight: 600;
            width: 16px; height: 16px;
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
        }

        /* --- 3. HERO VIEW (1ST VIEW) --- */
        #hero-view {
            width: 100%; height: 100vh;
            padding-top: 55px;
            display: flex; align-items: center; justify-content: center;
            padding-inline: 20px;
        }

        /* Transparent Floating Box */
        .glass-hero-box {
            background: rgba(255, 255, 255, 0.12); /* Highly transparent */
            backdrop-filter: blur(4px); /* Slight blur to read text but see BG */
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 20px;
            padding: 25px 20px;
            text-align: center;
            width: 100%; max-width: 340px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .hero-title {
            font-family: var(--font-calligraphy);
            font-size: 32px;
            color: var(--text-dark);
            margin-bottom: 10px;
            text-shadow: 0 1px 4px rgba(255,255,255,0.9);
        }

        .welcome-note {
            font-size: 12.5px;
            color: var(--text-dark);
            font-weight: 500;
            text-shadow: 0 1px 3px rgba(255,255,255,0.8);
        }

        /* --- MAIN SCROLL CONTAINER --- */
        #main-content {
            padding: 20px 15px;
            position: relative;
            z-index: 5;
            min-height: 100vh;
        }

        /* Generic Transparent Box */
        .glass-box {
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(5px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 15px;
            padding: 15px;
            margin-bottom: 25px;
        }

        .section-title {
            font-family: var(--font-calligraphy);
            font-size: 24px;
            text-align: center;
            margin-bottom: 12px;
            color: var(--text-dark);
            text-shadow: 0 1px 3px rgba(255,255,255,0.7);
        }

        /* --- ABOUT SPECIALISTS (1 Liners) --- */
        .specialist-bar {
            background: rgba(255, 255, 255, 0.2);
            border-left: 3px solid var(--golden-rose);
            padding: 8px 12px;
            margin-bottom: 8px;
            border-radius: 6px;
            font-size: 11.5px;
            font-weight: 500;
            display: flex; align-items: center; gap: 10px;
        }
        .specialist-bar:last-child { margin-bottom: 0; }

        /* --- FILTER BAR (Categories + Search) --- */
        .filter-container {
            display: flex;
            align-items: center;
            background: rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(6px);
            border-radius: 25px;
            border: 1px solid var(--sky-blue);
            margin-bottom: 20px;
            padding: 4px;
        }

        .cat-scroll {
            width: 80%;
            display: flex; gap: 8px;
            overflow-x: auto;
            scrollbar-width: none;
            padding: 4px;
        }
        .cat-scroll::-webkit-scrollbar { display: none; }

        .cat-btn {
            background: rgba(255,255,255,0.4);
            border: 1px solid var(--golden-rose);
            padding: 5px 12px;
            border-radius: 15px;
            font-size: 11px;
            white-space: nowrap;
            color: var(--text-dark);
            cursor: pointer;
        }
        .cat-btn.active {
            background: var(--golden-rose); color: white;
        }

        .search-icon-box {
            width: 20%;
            display: flex; justify-content: center; align-items: center;
            border-left: 1px solid rgba(0,0,0,0.1);
            color: var(--text-dark);
            font-size: 13px;
        }

        /* --- PRODUCT GRID (20+ Items) --- */
        .product-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            margin-bottom: 30px;
        }

        .product-card {
            background: rgba(255, 255, 255, 0.18);
            backdrop-filter: blur(6px);
            border: 1px solid rgba(255, 255, 255, 0.4);
            border-bottom: 2px solid var(--baby-pink);
            border-radius: 12px;
            padding: 8px;
            display: flex; flex-direction: column;
        }

        .product-img {
            width: 100%; height: 120px;
            border-radius: 8px; object-fit: cover;
            margin-bottom: 8px;
            background: rgba(255,255,255,0.3);
        }

        .product-name {
            font-size: 11.5px; font-weight: 600;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
            margin-bottom: 4px; color: var(--text-dark);
        }

        .product-bottom {
            display: flex; justify-content: space-between; align-items: center;
            margin-top: auto;
        }

        .product-price { font-size: 12px; font-weight: 600; color: #4a192c; }

        .add-btn {
            background: var(--sky-blue);
            border: none; padding: 4px 10px; border-radius: 6px;
            font-size: 10.5px; font-weight: 600; cursor: pointer; color: #fff;
        }

        /* --- VIP PRODUCTS (Horizontal Scroll - 4 Items) --- */
        .vip-scroll {
            display: flex; gap: 12px;
            overflow-x: auto; scrollbar-width: none;
            padding-bottom: 10px; margin-bottom: 25px;
        }
        .vip-scroll::-webkit-scrollbar { display: none; }

        .vip-card {
            min-width: 200px;
            background: rgba(255, 255, 255, 0.22);
            backdrop-filter: blur(8px);
            border: 1.5px solid var(--golden-rose);
            border-radius: 12px; padding: 10px; flex-shrink: 0;
            position: relative;
        }

        .vip-badge {
            position: absolute; top: -8px; left: 10px;
            background: var(--text-dark); color: var(--golden-rose);
            font-size: 8.5px; padding: 2px 8px; border-radius: 8px;
            text-transform: uppercase; z-index: 2;
        }

        .vip-img {
            width: 100%; height: 140px; /* Slightly larger */
            border-radius: 10px; object-fit: cover; margin-bottom: 8px;
        }

        /* --- WHATSAPP LIVE INVITATION --- */
        .wa-box {
            text-align: center;
        }
        .wa-title { font-size: 13.5px; font-weight: 600; color: #166534; margin-bottom: 4px; }
        .wa-sub { font-size: 11px; margin-bottom: 10px; color: var(--text-dark); }
        .wa-flex { display: flex; gap: 8px; }
        .wa-input {
            flex: 1; padding: 8px 12px; border-radius: 8px;
            border: 1px solid var(--golden-rose);
            background: rgba(255,255,255,0.6); font-size: 11px; outline: none;
        }
        .wa-btn {
            background: #25d366; color: white; border: none;
            padding: 0 15px; border-radius: 8px; font-size: 11px; font-weight: 600;
        }

        /* --- REVIEWS (Horizontal) --- */
        .review-scroll {
            display: flex; gap: 12px; overflow-x: auto; scrollbar-width: none;
        }
        .review-scroll::-webkit-scrollbar { display: none; }
        .review-card {
            min-width: 220px;
            background: rgba(255, 255, 255, 0.2);
            border: 1px solid var(--sky-blue);
            border-radius: 10px; padding: 12px; flex-shrink: 0;
        }
        .stars { color: #f59e0b; font-size: 10px; margin-bottom: 4px; }
        .rev-name { font-size: 11.5px; font-weight: 600; }
        .rev-text { font-size: 10.5px; color: var(--text-dark); margin-top: 4px; }

        /* --- FAQS --- */
        .faq-item {
            border-bottom: 1px solid rgba(255,255,255,0.3); padding: 10px 0;
        }
        .faq-item:last-child { border-bottom: none; }
        .faq-q { font-size: 11.5px; font-weight: 600; display: flex; justify-content: space-between; cursor: pointer; }
        .faq-a { font-size: 10.5px; margin-top: 6px; display: none; color: var(--text-dark); }

        /* --- FOOTER --- */
        .footer-note {
            text-align: center; font-family: var(--font-calligraphy);
            font-size: 20px; color: var(--text-dark); margin: 25px 0 15px;
            text-shadow: 0 1px 2px rgba(255,255,255,0.8);
        }
        .certs { display: flex; justify-content: center; flex-wrap: wrap; gap: 8px; margin-bottom: 20px; }
        .cert-tag {
            background: rgba(255,255,255,0.3); border: 1px solid var(--golden-rose);
            padding: 4px 10px; border-radius: 6px; font-size: 9.5px; font-weight: 600;
        }

        /* --- CART MODAL (Add/Sub logic + "Checkout" only button) --- */
        #cart-modal {
            position: fixed; top: 0; right: -100%; width: 85%; max-width: 320px; height: 100vh;
            background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(15px);
            z-index: 2000; transition: right 0.3s ease; display: flex; flex-direction: column;
            border-left: 2px solid var(--golden-rose);
        }
        #cart-modal.active { right: 0; }
        .cart-head { padding: 15px; border-bottom: 1px solid rgba(0,0,0,0.1); display: flex; justify-content: space-between; }
        .cart-title { font-size: 14px; font-weight: 600; }
        .close-btn { background: none; border: none; font-size: 18px; cursor: pointer; }
        
        .cart-items { flex: 1; overflow-y: auto; padding: 15px; }
        .c-item { display: flex; gap: 10px; margin-bottom: 12px; padding-bottom: 12px; border-bottom: 1px dashed rgba(0,0,0,0.1); }
        .c-img { width: 50px; height: 50px; border-radius: 6px; object-fit: cover; }
        .c-info { flex: 1; }
        .c-name { font-size: 11px; font-weight: 600; margin-bottom: 2px; }
        .c-price { font-size: 10.5px; color: var(--golden-rose); font-weight: 600; }
        .qty-box { display: flex; align-items: center; gap: 6px; margin-top: 4px; }
        .qty-btn { background: rgba(0,0,0,0.05); border: 1px solid rgba(0,0,0,0.1); width: 20px; height: 20px; border-radius: 4px; font-size: 10px; cursor: pointer; }
        
        .cart-foot { padding: 15px; background: rgba(252, 231, 243, 0.6); }
        .c-total { display: flex; justify-content: space-between; font-size: 13px; font-weight: 600; margin-bottom: 10px; }
        .checkout-btn { width: 100%; background: var(--text-dark); color: white; border: none; padding: 10px; border-radius: 8px; font-size: 12px; font-weight: 600; cursor: pointer; }
        
        .overlay { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.5); z-index: 1999; display: none; }
        .overlay.active { display: block; }
    </style>
</head>
<body>

    <!-- 1. SPLASH SCREEN -->
    <div id="splash-screen">
        <div class="splash-content">
            <!-- Using 1st background image as Logo based on constraints -->
            <img src="1000004738.jpg" class="splash-logo" alt="Logo">
            <div class="splash-text">Lily & Pearl</div>
        </div>
    </div>

    <!-- 2. NAVBAR -->
    <nav class="navbar">
        <div class="nav-brand">
            <img src="1000004738.jpg" alt="Logo">
            <span class="nav-title">Lily & Pearl</span>
        </div>
        <div class="cart-icon-wrapper" onclick="toggleCart()">
            <i class="fa-solid fa-cart-shopping"></i>
            <span class="cart-badge" id="cart-count">0</span>
        </div>
    </nav>

    <!-- FIXED BACKGROUNDS -->
    <div id="fixed-bg-2"></div>
    <div id="hero-bg-1"></div>

    <!-- 3. HERO VIEW -->
    <section id="hero-view">
        <div class="glass-hero-box">
            <div class="hero-title">Lily & Pearl</div>
            <p class="welcome-note">
                Welcome to a world of minimal aesthetics.<br>
                Handcrafted pieces designed for elegance.<br>
                Discover waterproof, anti-tarnish jewelry.<br>
                Let your everyday sparkle beautifully.<br>
                Find your perfect aesthetic here.
            </p>
        </div>
    </section>

    <!-- MAIN SCROLLING CONTENT -->
    <main id="main-content">
        
        <!-- ABOUT -->
        <section class="glass-box">
            <h2 class="section-title">About & Specs</h2>
            <div class="specialist-bar"><i class="fa-solid fa-gem" style="color:var(--golden-rose)"></i> 100% Anti-Tarnish & Waterproof</div>
            <div class="specialist-bar"><i class="fa-solid fa-leaf" style="color:var(--sky-blue)"></i> Skin Safe Minimalist Aesthetics</div>
            <div class="specialist-bar"><i class="fa-solid fa-droplet" style="color:var(--golden-rose)"></i> Premium Rose Gold & Pearl Finish</div>
        </section>

        <!-- HORIZONTAL FILTER BAR -->
        <div class="filter-container">
            <div class="cat-scroll">
                <button class="cat-btn active">All</button>
                <button class="cat-btn">Necklace</button>
                <button class="cat-btn">Bracelet</button>
                <button class="cat-btn">Pendant</button>
                <button class="cat-btn">Rings</button>
                <button class="cat-btn">Earrings</button>
            </div>
            <div class="search-icon-box">
                <i class="fa-solid fa-magnifying-glass"></i>
            </div>
        </div>

        <!-- 20+ PRODUCTS GRID -->
        <div class="product-grid" id="product-grid">
            <!-- Rendered by JS -->
        </div>

        <!-- 4 VIP PRODUCTS -->
        <section class="glass-box" style="padding-bottom: 5px;">
            <h2 class="section-title">VIP Collection</h2>
            <div class="vip-scroll" id="vip-grid">
                <!-- Rendered by JS -->
            </div>
        </section>

        <!-- WHATSAPP INVITE -->
        <section class="glass-box wa-box">
            <div class="wa-title">Join VIP Secret Group</div>
            <div class="wa-sub">Drop your number for live admin invite</div>
            <div class="wa-flex">
                <input type="tel" id="wa-num" class="wa-input" placeholder="Phone No.">
                <button class="wa-btn" onclick="joinGroup()">Join</button>
            </div>
        </section>

        <!-- REVIEWS -->
        <section class="glass-box">
            <h2 class="section-title">Client Love</h2>
            <div class="review-scroll">
                <div class="review-card">
                    <div class="stars">★★★★★</div>
                    <div class="rev-name">Aarohi M.</div>
                    <div class="rev-text">"So aesthetic! Looks exact like pictures. Minimal & elegant."</div>
                </div>
                <div class="review-card">
                    <div class="stars">★★★★★</div>
                    <div class="rev-name">Kritika S.</div>
                    <div class="rev-text">"The baby pink packaging! Quality of bracelet is amazing."</div>
                </div>
                <div class="review-card">
                    <div class="stars">★★★★☆</div>
                    <div class="rev-name">Pooja</div>
                    <div class="rev-text">"Worth it. Golden rose hasn't faded even after daily use."</div>
                </div>
            </div>
        </section>

        <!-- FAQS -->
        <section class="glass-box">
            <h2 class="section-title">FAQs</h2>
            <div class="faq-item">
                <div class="faq-q" onclick="toggleFaq(this)"><span>Is it tarnish-free?</span> <i class="fa-solid fa-plus"></i></div>
                <div class="faq-a">Yes, fully anti-tarnish for daily aesthetic wear.</div>
            </div>
            <div class="faq-item">
                <div class="faq-q" onclick="toggleFaq(this)"><span>Delivery time?</span> <i class="fa-solid fa-plus"></i></div>
                <div class="faq-a">3-5 business days across India.</div>
            </div>
        </section>

        <!-- FOOTER -->
        <div class="footer-note">
            Thank you for reaching out.<br>
            Stay Aesthetic.<br>
            ~ Lily & Pearl
        </div>

        <div class="certs">
            <div class="cert-tag">ISO Certified</div>
            <div class="cert-tag">Skin Safe</div>
            <div class="cert-tag">Verified Brand</div>
        </div>
    </main>

    <!-- CART MODAL -->
    <div class="overlay" id="overlay" onclick="toggleCart()"></div>
    <div id="cart-modal">
        <div class="cart-head">
            <div class="cart-title">Your Cart</div>
            <button class="close-btn" onclick="toggleCart()"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div class="cart-items" id="cart-items"></div>
        <div class="cart-foot">
            <div class="c-total"><span>Total</span><span id="cart-total">₹0</span></div>
            <!-- Text strictly Checkout -->
            <button class="checkout-btn" onclick="checkout()">Checkout</button>
        </div>
    </div>

    <!-- JAVASCRIPT -->
    <script>
        // SCROLL MAGIC (Requirement 4: 30% scroll hides 1st BG, brings it back on scroll up)
        window.addEventListener('scroll', () => {
            const heroBg = document.getElementById('hero-bg-1');
            // Calculate 30% of viewport height
            const threshold = window.innerHeight * 0.3;
            if (window.scrollY > threshold) {
                heroBg.classList.add('hide-hero-bg');
            } else {
                heroBg.classList.remove('hide-hero-bg');
            }
        });

        // 21 Normal Products Array
        const products = Array.from({length: 21}, (_, i) => ({
            id: i + 1,
            name: `Aesthetic Piece ${i+1}`,
            price: 399 + (i * 20),
            img: "https://images.unsplash.com/photo-1599643477877-530eb83abc8e?w=200&q=80"
        }));

        // 4 VIP Products Array
        const vipProducts = [
            { id: 101, name: "Royal Rose Choker", price: 1299, img: "1000004738.jpg" },
            { id: 102, name: "Sky Pearl Cuff", price: 1499, img: "1000004739.jpg" },
            { id: 103, name: "Diamond Drop VIP", price: 1899, img: "https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?w=300" },
            { id: 104, name: "Golden Flora Ring", price: 1199, img: "https://images.unsplash.com/photo-1605100804763-247f67b3557e?w=300" }
        ];

        let cart = [];

        window.onload = () => {
            // Render Normal Products
            document.getElementById('product-grid').innerHTML = products.map(p => `
                <div class="product-card">
                    <img src="${p.img}" class="product-img" loading="lazy">
                    <div class="product-name">${p.name}</div>
                    <div class="product-bottom">
                        <span class="product-price">₹${p.price}</span>
                        <button class="add-btn" onclick="addToCart(${p.id}, false)">Add</button>
                    </div>
                </div>
            `).join('');

            // Render VIP Products
            document.getElementById('vip-grid').innerHTML = vipProducts.map(p => `
                <div class="vip-card">
                    <div class="vip-badge">VIP</div>
                    <img src="${p.img}" class="vip-img" loading="lazy">
                    <div class="product-name" style="font-size: 12.5px;">${p.name}</div>
                    <div class="product-bottom">
                        <span class="product-price">₹${p.price}</span>
                        <button class="add-btn" style="background:var(--golden-rose);" onclick="addToCart(${p.id}, true)">Add</button>
                    </div>
                </div>
            `).join('');
        };

        // Cart Logic
        function addToCart(id, isVip) {
            const list = isVip ? vipProducts : products;
            const item = list.find(p => p.id === id);
            const existing = cart.find(c => c.id === id);
            if(existing) existing.qty += 1;
            else cart.push({...item, qty: 1});
            updateCart();
        }

        function updateQty(id, change) {
            const item = cart.find(c => c.id === id);
            if(item) {
                item.qty += change;
                if(item.qty <= 0) cart = cart.filter(c => c.id !== id);
            }
            updateCart();
        }

        function updateCart() {
            const count = cart.reduce((sum, item) => sum + item.qty, 0);
            document.getElementById('cart-count').innerText = count;

            const container = document.getElementById('cart-items');
            if(cart.length === 0) {
                container.innerHTML = `<div style="text-align:center; color:#777; font-size:11px; margin-top:20px;">Cart is empty.</div>`;
                document.getElementById('cart-total').innerText = '₹0';
                return;
            }

            let total = 0;
            container.innerHTML = cart.map(item => {
                total += item.price * item.qty;
                return `
                    <div class="c-item">
                        <img src="${item.img}" class="c-img">
                        <div class="c-info">
                            <div class="c-name">${item.name}</div>
                            <div class="c-price">₹${item.price}</div>
                            <div class="qty-box">
                                <button class="qty-btn" onclick="updateQty(${item.id}, -1)">-</button>
                                <span style="font-size:11px; width:15px; text-align:center; font-weight:600;">${item.qty}</span>
                                <button class="qty-btn" onclick="updateQty(${item.id}, 1)">+</button>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
            document.getElementById('cart-total').innerText = '₹' + total;
        }

        function toggleCart() {
            document.getElementById('cart-modal').classList.toggle('active');
            document.getElementById('overlay').classList.toggle('active');
        }

        function checkout() {
            if(cart.length === 0) return alert("Add items to cart first!");
            const fakeNo = "919876543210";
            let txt = "Order from Lily %26 Pearl:%0A";
            let t = 0;
            cart.forEach(i => {
                txt += `• ${i.name} (x${i.qty}) - ₹${i.price * i.qty}%0A`;
                t += i.price * i.qty;
            });
            txt += `%0ATotal: ₹${t}`;
            window.open(`https://wa.me/${fakeNo}?text=${txt}`, '_blank');
        }

        function joinGroup() {
            const no = document.getElementById('wa-num').value;
            if(!no) return alert("Enter number");
            window.open(`https://wa.me/919876543210?text=Add my no ${no} to VIP group`, '_blank');
        }

        function toggleFaq(el) {
            const ans = el.nextElementSibling;
            const icon = el.querySelector('i');
            if(ans.style.display === 'block') {
                ans.style.display = 'none'; icon.className = 'fa-solid fa-plus';
            } else {
                ans.style.display = 'block'; icon.className = 'fa-solid fa-minus';
            }
        }
    </script>
</body>
</html>
 
